---
type Highlight = {
  title: string;
  description: string;
  icon: string;
};

const highlights: Highlight[] = [
  {
    title: 'No data collection',
    description:
      'HeaderTweaker collects no data whatsoever — no analytics, no tracking, no accounts.',
    icon: 'M4.9 4.9 19 19M12 3 4 6v6c0 5 3.4 7.7 8 9 1.6-.45 3-1.15 4.15-2.05M20 12V6l-8-3',
  },
  {
    title: 'Stored locally',
    description:
      'All rules and settings live in your browser’s local storage — they never leave your device.',
    icon: 'M4 7c0-1.66 3.58-3 8-3s8 1.34 8 3-3.58 3-8 3-8-1.34-8-3Zm0 0v10c0 1.66 3.58 3 8 3s8-1.34 8-3V7',
  },
  {
    title: 'Least-privilege permissions',
    description:
      'The extension requests the smallest possible set of browser permissions to do its job.',
    icon: 'M12 3 4 6v6c0 5 3.4 7.7 8 9 4.6-1.3 8-4 8-9V6l-8-3Zm-1.5 9 1.5 1.5 3-3',
  },
  {
    title: 'Open source',
    description:
      'The full source is public on GitHub, so anyone can audit exactly what it does.',
    icon: 'M9 19c-4 1.5-4-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.5 1.3a12 12 0 0 0-6 0C6.6 2.3 5.6 2.6 5.6 2.6a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21',
  },
];
---

<section id="privacy" class="privacy">
  <div class="container privacyInner">
    <div class="intro">
      <p class="eyebrow">Privacy first</p>
      <h2>Built to protect your data</h2>
      <p class="lead">
        HeaderTweaker is designed around a simple principle: your data is yours.
        It requests the smallest possible set of browser permissions and
        collects nothing about you or your browsing.
      </p>
    </div>

    <ul class="grid">
      {
        highlights.map((highlight) => (
          <li class="card">
            <span class="icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={highlight.icon} />
              </svg>
            </span>
            <h3>{highlight.title}</h3>
            <p>{highlight.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="permissions">
      <h3 class="permissionsTitle">Why each permission is needed</h3>
      <div class="tables">
        <div class="permissionCard">
          <h4>Firefox</h4>
          <dl>
            <div class="row">
              <dt><code>storage</code></dt>
              <dd>Persist header rules and settings locally in the browser.</dd>
            </div>
            <div class="row">
              <dt><code>webRequest</code> + <code>webRequestBlocking</code></dt>
              <dd>
                Modify outgoing request headers before they are sent (Firefox
                uses the <code>webRequest</code> API).
              </dd>
            </div>
            <div class="row">
              <dt><code>&lt;all_urls&gt;</code></dt>
              <dd>
                Allow rules to target any site. Rules only run on requests that
                match the URL patterns you define.
              </dd>
            </div>
          </dl>
        </div>

        <div class="permissionCard">
          <h4>Chrome</h4>
          <dl>
            <div class="row">
              <dt><code>storage</code></dt>
              <dd>Persist header rules and settings locally in the browser.</dd>
            </div>
            <div class="row">
              <dt><code>declarativeNetRequestWithHostAccess</code></dt>
              <dd>
                Modify outgoing request headers via Chrome’s
                <code>declarativeNetRequest</code> API, which changes requests
                <strong>without</strong> the extension reading their contents.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .privacy {
    padding-block: vars.$spacing-core-20;
  }

  .intro {
    max-width: 680px;
    margin: 0 auto vars.$spacing-core-12;
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: vars.$spacing-core-4;
    padding: vars.$spacing-core-1 vars.$spacing-core-4;
    border: 1px solid rgb(vars.$colors-primary-success, 0.4);
    border-radius: vars.$border-radius-full;
    color: vars.$colors-primary-success;
    font-size: 0.875rem;
  }

  .intro h2 {
    margin-bottom: vars.$spacing-core-4;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
  }

  .lead {
    color: vars.$colors-tertiary-foreground;
    font-size: 1.0625rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: vars.$spacing-core-6;
    list-style: none;
    padding: 0;
    margin: 0 0 vars.$spacing-core-16;
  }

  .card {
    padding: vars.$spacing-core-6;
    border: 1px solid rgb(vars.$colors-tertiary-foreground, 0.12);
    border-radius: vars.$border-radius-primary;
    background: rgb(vars.$colors-primary-foreground, 0.02);

    h3 {
      margin-bottom: vars.$spacing-core-2;
      font-size: 1.125rem;
    }

    p {
      color: vars.$colors-tertiary-foreground;
      line-height: 1.6;
    }
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: vars.$spacing-core-4;
    border-radius: vars.$border-radius-primary;
    background: rgb(vars.$colors-primary-success, 0.15);
    color: vars.$colors-primary-success;

    svg {
      width: 22px;
      height: 22px;
    }
  }

  .permissions {
    padding: vars.$spacing-core-10;
    border: 1px solid rgb(vars.$colors-tertiary-foreground, 0.12);
    border-radius: vars.$border-radius-primary;
    background: rgb(vars.$colors-primary-foreground, 0.02);
  }

  .permissionsTitle {
    margin-bottom: vars.$spacing-core-8;
    text-align: center;
    font-size: 1.375rem;
  }

  .tables {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: vars.$spacing-core-8;
  }

  .permissionCard h4 {
    margin-bottom: vars.$spacing-core-4;
    padding-bottom: vars.$spacing-core-3;
    border-bottom: 1px solid rgb(vars.$colors-tertiary-foreground, 0.12);
    font-size: 1.125rem;
  }

  dl {
    margin: 0;
  }

  .row {
    padding-block: vars.$spacing-core-4;

    & + .row {
      border-top: 1px solid rgb(vars.$colors-tertiary-foreground, 0.08);
    }
  }

  dt {
    margin-bottom: vars.$spacing-core-2;
    color: vars.$colors-primary-foreground;
    font-weight: 600;
  }

  dd {
    margin: 0;
    color: vars.$colors-tertiary-foreground;
    line-height: 1.6;
  }

  code {
    padding: 2px 6px;
    border-radius: vars.$border-radius-small;
    background: vars.$colors-primary-action-disabled;
    color: vars.$colors-primary-foreground;
    font-size: 0.85em;
  }

  strong {
    color: vars.$colors-primary-foreground;
  }
</style>
