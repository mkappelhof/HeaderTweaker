{
  "name": "headertweaker-monorepo",
  "version": "0.0.0",
  "description": "Monorepo for the HeaderTweaker browser extension and marketing website",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "build:all": "turbo run build:all",
    "build:firefox": "turbo run build:firefox",
    "build:chrome": "turbo run build:chrome",
    "dev:firefox": "turbo run dev:firefox",
    "dev:firefox:console": "turbo run dev:firefox:console",
    "dev:chrome": "turbo run dev:chrome",
    "dev:chrome:console": "turbo run dev:chrome:console",
    "dev:website": "turbo run dev --filter=headertweaker-website",
    "change": "changeset",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --fix",
    "format": "biome format . && stylelint 'apps/*/src/**/*.scss' 'packages/*/src/**/*.scss'",
    "format:fix": "biome format . --fix && stylelint --fix 'apps/*/src/**/*.scss' 'packages/*/src/**/*.scss'",
    "format-n-lint": "pnpm lint && pnpm format",
    "format-n-lint:fix": "pnpm lint:fix && pnpm format:fix",
    "check": "biome check .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "husky": "9.1.7",
    "rimraf": "6.1.3",
    "stylelint": "17.15.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-scss": "7.3.0",
    "turbo": "2.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@parcel/watcher", "esbuild", "sharp"]
  }
}
